{
  "description": "aipprentice: inject global knowledge at session start; queue substantive sessions for debrief at session end",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/aipprentice.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/aipprentice.py\" session-end",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
